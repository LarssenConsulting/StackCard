{
  "info": {
    "name": "StackCard, API de lecture",
    "description": "Lecture seule. Renseignez les variables de la collection `baseUrl` et `token`, et appelez depuis une adresse IP autorisée pour ce jeton. Le premier appel de la liste remplit `serverId` (id ou slug du premier serveur). Spécification complète : stackcard-read-api.openapi.yaml.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://stackcard.example.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "serverId",
      "value": "web01",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Serveurs",
      "item": [
        {
          "name": "Lister les serveurs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const servers = pm.response.json().data;",
                  "pm.test('Liste non vide', () => pm.expect(servers).to.be.an('array').that.is.not.empty);",
                  "if (servers.length) { pm.collectionVariables.set('serverId', servers[0].slug ?? String(servers[0].id)); }",
                  "pm.test('Pas de notes ni de machine_id', () => { pm.expect(pm.response.text()).to.not.include('machine_id'); pm.expect(pm.response.text()).to.not.include('\"notes\"'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/servers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "servers"
              ]
            },
            "description": "Remplit la variable `serverId` (id ou slug) avec le premier serveur."
          },
          "response": []
        },
        {
          "name": "Détailler un serveur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const server = pm.response.json().data;",
                  "pm.test('Sections sans contenu', () => Object.values(server.sections).forEach(s => pm.expect(s).to.not.have.property('data')));",
                  "pm.test('Champs attendus', () => pm.expect(server).to.include.keys('sites', 'firewall', 'sections', 'sections_never_received'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/servers/{{serverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "servers",
                "{{serverId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
