[Unit]
Description=Discover inventory agent (collect and send)
After=network-online.target mysql.service mariadb.service apache2.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/discover-agent run
# Root is needed to read site configs, /proc and MySQL over its socket.
# Writes are limited to the agent state directory.
ProtectSystem=full
ReadWritePaths=/var/lib/discover-agent
PrivateTmp=yes
# Site files are user-controlled: a symlink to a real device must lead nowhere.
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Worst case: about 19.5 min of sections (2 weekly x 300 s, apt_updates 210 s, 12 x 30 s), plus the inventory POST (300 s per socket operation).
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
